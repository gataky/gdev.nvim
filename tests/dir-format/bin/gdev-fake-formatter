#!/bin/sh
# Fake formatter under a name no real tool uses, for the `config.command`
# override cases. Behaves like the other fakes: records argv, rewrites the file.
[ -n "$GDEV_FORMAT_ARGV_LOG" ] && printf '%s\n' "${0##*/}" "$@" >>"$GDEV_FORMAT_ARGV_LOG"
for target in "$@"; do :; done
[ -n "$target" ] || exit 0
printf 'extends Node\n# formatted by %s\n' "${0##*/}" >"$target"
